#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR"

# 构建结束后清理自动生成的构建信息文件，避免陈旧数据污染开发环境
trap 'rm -f src/_build_info.py' EXIT

# 查找可用的 Python
if command -v uv &>/dev/null; then
    PYTHON="uv run python"
elif [ -x ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
else
    PYTHON="python"
fi

NAME="csv_plot"
ENTRY="csv_plot.py"

echo "========================================"
echo " Building $NAME with Nuitka (optimized) "
echo "========================================"
echo "Entry: $ENTRY"
echo

if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    PLATFORM_OPTS=(
        "--windows-console-mode=disable"
        "--windows-icon-from-ico=assets/icon.ico"
    )
else
    PLATFORM_OPTS=(
        "--macos-create-app-bundle"
        "--macos-app-icon=assets/icon.icns"
    )
fi

echo "Generating build info..."
$PYTHON scripts/generate_build_info.py
echo

# 第三方许可证（方案 §9 R3）：python-can 是 LGPL-3.0，分发产物必须附许可证。
# 许可证位置在新旧包之间不统一（PEP 639 写 dist-info/licenses/，旧式直接
# 写 dist-info/LICENSE），所以交给 Python 用元数据查，而不是拼硬编码路径。
resolve_license() {
    $PYTHON -c "import os,sys,importlib.metadata as md
wanted=('LICENSE','LICENSE.txt','LICENSE.md','COPYING','COPYING.LESSER')
try:
    d=md.distribution(sys.argv[1])
except Exception:
    sys.exit(1)
base=str(d.locate_file(''))
for f in (d.files or ()):
    n=str(f).replace(chr(92),'/')
    if n.rpartition('/')[2] not in wanted or '.dist-info' not in n: continue
    p=os.path.join(base,*n.split('/'))
    if os.path.isfile(p):
        print(p)
        break
" "$1" 2>/dev/null
}

LICENSE_OPTS=()
for entry in "python-can:python-can-LICENSE.txt" "canmatrix:canmatrix-LICENSE"; do
    dist="${entry%%:*}"
    target="${entry##*:}"
    lic="$(resolve_license "$dist" || true)"
    if [ -n "$lic" ]; then
        LICENSE_OPTS+=("--include-data-file=$lic=licenses/$target")
        echo "附带第三方许可证: $dist -> licenses/$target"
    else
        echo "WARN 未找到 $dist 的 LICENSE，发布前需手工补附"
    fi
done

# BLF / CAN 数据库（方案 §4）相关的打包取舍：
# * can: 只用到 can.io.blf 的 BLFReader，但 `import can` 会拉起 can.io 整层。
# * canmatrix.formats 用 importlib.import_module("canmatrix.formats." + 名字)
#   动态装载解析器，且把 ImportError 吞成一条 debug 日志 —— 整包 include 是唯一
#   可靠写法，漏掉时产物表现为「BLF 导入后一个信号也没有」，极难归因。
# * lxml: canmatrix 的 arxml 解析器硬依赖（原先下面有一行
#   --nofollow-import-to=lxml，已删；保留它等于打包版永远读不了 ARXML）。
# * 硬件后端（can.interfaces.<23 个>）无需排除：它们只在 BACKENDS 字典里以名字
#   存在、按需 import，实测加载 BLFReader 后零个后端进 sys.modules；而 can/util.py
#   有 `from .interfaces import VALID_INTERFACES`，把整个 can.interfaces 排掉会让
#   `import can` 直接崩（PyInstaller 那边因此是逐个排子模块）。
#
# 注意：bash 里反引号续行（行尾 \）之间**不能**插注释行 —— 注释会吃掉续行并把
# 后面的参数当独立命令执行，所以下面这一串参数必须保持连续。
nuitka --standalone \
    --output-filename="$NAME" \
    --enable-plugin=pyside6 \
    --enable-plugin=numpy \
    --include-package=src \
    --include-package=asammdf \
    --include-package=asammdf.blocks \
    --include-package=can \
    --include-package=can.io \
    --include-package=canmatrix \
    --include-package=canmatrix.formats \
    --include-package=lxml \
    --include-module=numpy \
    --include-module=pandas \
    --include-module=chardet \
    --include-module=charset_normalizer \
    --include-data-file=assets/icon.ico=assets/icon.ico \
    --include-data-file=assets/icon.icns=assets/icon.icns \
    --include-data-file=assets/icon.png=assets/icon.png \
    --include-data-file=README.md=README.md \
    --include-data-file=docs/help.md=docs/help.md \
    "${LICENSE_OPTS[@]}" \
    --follow-imports \
    --nofollow-import-to=nuitka \
    --nofollow-import-to=pytest \
    --nofollow-import-to=pyinstaller \
    --nofollow-import-to=tkinter \
    --nofollow-import-to=unittest \
    --nofollow-import-to=test \
    --nofollow-import-to=distutils \
    --nofollow-import-to=setuptools \
    --nofollow-import-to=pip \
    --nofollow-import-to=wheel \
    --nofollow-import-to=scipy \
    --nofollow-import-to=PIL \
    --nofollow-import-to=cv2 \
    --nofollow-import-to=matplotlib \
    --lto=yes \
    --jobs=8 \
    "${PLATFORM_OPTS[@]}" \
    "$ENTRY"

if [ $? -eq 0 ]; then
    echo
    echo "========================================"
    echo " Build succeeded!"
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo " Output: $NAME.app"
    else
        echo " Output: $NAME.dist/$NAME.exe"
    fi
    echo "========================================"
else
    echo
    echo "========================================"
    echo " Build failed!"
    echo "========================================"
    exit 1
fi
